@article{FalkHuffmanMacLeod2015J.LaborEcon.,
  title = {Institutions and Contract Enforcement},
  shorttitle = {New Evidence on Employment Protection, Bonus Pay, and Labor Market Performance},
  author = {Falk, Armin and Huffman, David and MacLeod, W. Bentley},
  date = {2015},
