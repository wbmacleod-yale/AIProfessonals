  journaltitle = {Brooklyn Law Review},
  shortjournal = {Brooklyn Law Rev.},
  volume = {85},
  number = {2},
  doi = {10.2139/ssrn.3314882},
  abstract = {The impossibility doctrine -- under which a contracting party has no duty to perform the agreement if performance thereof is rendered impossible -- is a basic building block of U.S. contract law. The prevailing law-and-economics analysis of this doctrine suggests that when contract performance becomes impossible, courts should assign the contractual risk of non-performance to the superior risk bearer, i.e., to the party that can bear said risk at least cost. {$<$}br{$><$}br{$>$}This Article empirically tests, for the first time, the economic theory of the impossibility doctrine. It first hypothesizes that most sophisticated parties to commercial contracts are unlikely to adopt the economic superior risk bearer model given its high implementation costs and its uncertain results. It then aims to expose the actual preference of real-world contract parties for the economic model. By examining 1,926 commercial contracts that were disclosed to the Securities and Exchange Commission (SEC), this Article finds that most parties prefer not to adopt the economic model. This finding casts considerable doubt over the efficiency of this model for the parties.},
  language = {en},
  file = {/home/wbmacleod/Zotero/storage/2RSXJS26/Benoliel - 2020 - The Impossibility Doctrine in Commercial Contracts An Empirical Analysis.pdf}
}

@article{BensonSojournerUmyarov2020Manag.Sci.,
  title = {Can Reputation Discipline the Gig Economy? Experimental Evidence from an Online Labor Market},
  shorttitle = {Can Reputation Discipline the Gig Economy?},
  author = {Benson, Alan and Sojourner, Aaron and Umyarov, Akhmed},
  date = {2020-05},
