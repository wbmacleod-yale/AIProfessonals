  institution = {United States Bankruptcy Court for the Southern District of Texas, Houston Division},
  abstract = {In 2020, Serta executed a liability management transaction with a favored group of lenders, exchanging old debt for new loans. A minority excluded group represented by AG Centre Street Partnership was excluded from the deal, and the group sued, arguing that Serta had violated a pro rata sharing provision in their 2016 credit agreement, which essentially required equal treatment for all lenders. Serta argued that the 2020 transaction was an "open market purchase" that had an explicit exemption from the pro rata sharing provision. The Fifth Circuit had removed that exemption as a defense, and the question before the District Court for the Southern District of Texas was whether the 2020 exchange was a "payment," in which case it would activate the pro rata sharing provision. The district judge rejected Serta's argument that the provision only applied to cash payments by applying textual analysis. In particular, the use of an explicit carve-out in the credit agreement preventing certain non-cash transactions from ratable sharing implied Serta had recognized cashless debt exchanges as payments, and the use of the word "cash" to specify cash transactions further pointed to a broad enough definition of "payments" in the pro rata sharing provision to encompass the 2020 exchange.},
  file = {/home/wbmacleod/Zotero/storage/GNE4HKLL/Serta Simmons Bedding LLC v. AG Ctr. St. P'ship (In re.PDF;/home/wbmacleod/Zotero/storage/MTW3SHGA/Christopher M. López - 2026 - Serta Simmons Bedding LLC v. AG Ctr. St. P'ship (In re Serta Simmons Bedding, LLC).pdf}
