@book{Dobbs2000,
  title = {The Law of Torts},
  author = {Dobbs, Dan B.},
  date = {2000},
  publisher = {West Group},
  location = {St. Paul, MN},
  abstract = {From p. 1088 of Dobbs: -"So (under several liability) defendants have an interest in asserting that all fault be considered, including the fault of nonparties, the fault of insolvent and immune tortfeasors, and the fault of intentional tortfeasors." -"Settling Tortfeasors. In a several liability system, the nonsettling tortfeasor is held responsible only for his comparative share. In determining the percentage responsibility of the nonsettling tortfeasor, jurors must determine the comparative share of every tortfeasor, including those who have settled. However, a determination that A's fault was 50\% and B's fault was 50\% does not affect A's settlement or his liability. It merely means that B is liable for 50\%, no more, no less. If A paid more than 50\% of the damages, that was his decision. If he paid less, the plaintiff made a bad bargain, but none of this matters to B's liability." My interpretation of this passage is that it shows that under JSL reform, a tortfeasor who is not judgment proof but who has already settled with the plaintiff may be asked to provide evidence and possibly appear in court after he has settled with the plaintiff, but before the other tortfeasor has either settled with the plaintiff or arrived at a trial verdict with the plaintiff. This feature of JSL reform means that anyone who might commit a tort - not just judgment-proof persons - faces higher expected costs under JSL reform, since there is a greater chance she will be dragged into court and/or asked to provide additional evidence during the discovery phase even after she has settled with the plaintiff. In contrast, under JSL with contribution, settling tortfeasors cannot be held liable for contribution, and there will be less reason to drag them into court to provide evidence after they have settled (under JSL with contribution, the non-settling tortfeasor gets to have the amount it needs to pay to the plaintiff be offset by a credit. Generally, this credit is equal to the amount the settling tortfeasor paid. Some of the states that grant this sort of credit allow judicial reviews of the size of the settlement the settling tortfeasor paid to make sure that the settlement was done in "good faith", i.e. not unreasonably low (Dobbs, p. 1084). Such judicial reviews can impose litigation costs on the settling tortfeasor, but I suspect that the good-faith settlement reviews aren't as costly as the process of trying to determine exactly how much liability should be apportioned to a tortfeasor that has settled under JSL reform - after all, courts and legislatures want to encourage settlement. A few other states actually have or have had JSL with contribution systems in which the credit to the non-settling tortfeasor was actually based on the percentage of fault attributable to the settling tortfeasor, so that if A settled and B did not, and A was judged to be responsible for 80\% of the negligence, B only was held responsible for 20\% of the damages (Dobbs, pp. 1084-1085). However, most states apply the former type of credit rather than this "proportionate share" credit. See "Settling Multidefendant Lawsuits: The Advantage of Conditional Setoff Rules", Klerman, Daniel, Journal of Legal Studies, June 1996, v. 25, iss. 2, pp. 445-62.) From p. 1089: -"Strategically, the defendant?s interest in this system (the several liability system) is to assert the negligence of many other persons regardless of (their) immunity. That is because all liabilities are comparative, not absolute, so that when fault is attributed to other tortfeasors, that reduces the fault attributable to the defendant."},
  creationdate = {2010-10-12T00:00:00},
  owner = {wbmacleod},
  keywords = {CCM-torts,CM-CLR}
}

