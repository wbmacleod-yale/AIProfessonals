  pages = {83--120},
  publisher = {Oxford University Press},
  issn = {8756-6222},
  url = {https://www.jstor.org/stable/3554998},
  urldate = {2026-07-09},
  abstract = {This article focuses on the widely held views that antitakeover charter and bylaw provisions (ATPs) increase agency costs, thereby reducing firm value, but that firms going public minimize agency costs, thereby maximizing firm value. We show that these views cannot comfortably coexist: ATPs are common in a sample of IPO-stage charters and are no less common when the firm is backed by venture capitalists or leveraged buyout funds. Moreover, ATP use is not explained by two efficiency explanations of ATP use with theoretical support-target firms' need for bargaining power when a bid is made and the threat of managerial myopia. Rather, we find evidence that antitakeover protection is used to protect management when takeovers are most likely and management performance most transparent. We find no evidence, however, that ATPs are explained by managers' desire to protect unusually high private benefits.}
