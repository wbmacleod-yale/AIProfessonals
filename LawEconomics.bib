  journaltitle = {F. 3d},
  volume = {851},
  pages = {69},
  institution = {Court of Appeals, 1st Circuit},
  abstract = {O'Connor v. Oakhurst Dairy exemplifies the often important role of ambiguity in statutes. The plaintiff, a delivery driver, sued his employer, Oakhurst Dairy, for inadequate overtime compensation. Oakhurst Dairy argued that under exemption F of the Maine Wage and Hour Law, which stated that Maine's overtime protection did not apply to "[t]he canning, processing, preserving, freezing, drying, marketing, storing, packing for shipment or distribution of: (1) Agricultural produce; (2) Meat and fish products; and (3) Perishable foods" (26 M.R.S.A. \S{} 664(3)(F)). The plaintiff argued that the absence of a comma between "shipment" and "distribution" prevented the exemption from applying to the delivery service, while Oakhurst argued that the exemption applied to both packing and distribution. While the Maine District Court sided with Oakhurst, the Court of Appeals for the First Circuit reversed. The appeals court jusitifed their decision by arguing that doing so aligned with the default rule of statutory construction in Maine, that statutes "should be liberally construed to further the beneficent purposes for which they are enacted," given that the purpose of the overtime law was to provide overtime pay to employees. The decision also suggests an order of operations for interpreting ambiguous language, moving from textual analysis (like gerund usage and asyndeton) to the legislative history.},
  file = {/home/wbmacleod/Zotero/storage/WVD5B6RI/David Barron - 2017 - O'Connor v. Oakhurst Dairy.PDF;/home/wbmacleod/Zotero/storage/QANSFPMV/2017 - O'connor v. Oakhurst Dairy.html}
}

