@article{LongEtAl2014IJoDP,
  title = {Income Level and Drug Related Harm among People Who Use Injection Drugs in a Canadian Setting},
  author = {Long, Cathy and DeBeck, Kora and Feng, Cindy and Montaner, Julio and Wood, Evan and Kerr, Thomas},
